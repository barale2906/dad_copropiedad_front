{
  "name": "dad-copropiedad-front",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Frontend web de DAD Copropiedad: navegación por maqueta 3D genérica.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --build && vite build",
    "typecheck": "vue-tsc --build",
    "lint": "eslint .",
    "format": "prettier --write src",
    "test": "vitest run",
    "tipos-api": "openapi-typescript /contrato/openapi.json -o src/api/esquema.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/rajdhani": "5.3.0",
    "decimal.js-light": "2.5.1",
    "openapi-fetch": "0.17.0",
    "pinia": "4.1.0",
    "three": "0.186.1",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@iconify-json/tabler": "1.2.42",
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "unplugin-icons": "24.0.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
